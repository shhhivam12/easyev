# -----------------------------------------------------------------------------
# EasyEV Environment Configuration Template
# -----------------------------------------------------------------------------
PORT=4173

# 1. Agora Realtime AI WebRTC Voice Engine
# Get credentials from: https://console.agora.io
AGORA_APP_ID=
# Server-only secret. Never place this value in index.html or commit it.
AGORA_APP_CERTIFICATE=

# Optional: use Sarvam bulbul:v3 with a male voice for Hindi/Hinglish agents.
# When absent, the existing Azure/OpenAI fallback remains unchanged.
SARVAM_API_KEY=
# Invalid or female speaker IDs fall back to shubh.
SARVAM_TTS_SPEAKER=shubh

# Optional selectable calm male Hindi Azure fallback voices.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# 2. Email Delivery (Gmail SMTP or Resend)
# Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EasyEV Test Drive <noreply@easyev.in>

# 3. Public HTTPS origin of the deployed service.
# Example: https://easyev.onrender.com
PUBLIC_BASE_URL=

# Strong random server-only value used for short-lived MCP session URLs.
MCP_SIGNING_SECRET=

# Optional but required for the one-time readiness snapshot tool.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional. A key improves Open Charge Map reliability.
OPENCHARGEMAP_API_KEY=

# Render Postgres connection string. Omit locally for the ephemeral fallback.
DATABASE_URL=

# Optional specialist desk protection and escalation notifications.
REP_DESK_KEY=
SLACK_WEBHOOK_URL=

# HubSpot private app token. Required scopes:
# crm.objects.contacts.read, crm.objects.contacts.write,
# crm.objects.deals.read, crm.objects.deals.write
HUBSPOT_TOKEN=

# Cal.com booking configuration.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
BOOKING_TIMEZONE=Asia/Kolkata

# --- Voice, mail and specialist desk (from the handoff work) ---
# Gmail used to send the buyer's booking confirmation and decision report.
# GMAIL_APP_PASSWORD is a 16-character app password, not the account password:
# enable 2-Step Verification, then create one at myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=EasyEV
