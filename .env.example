# Public project identifier used by the browser after the server returns it.
AGORA_APP_ID=

# Server-only secret. Never place this value in index.html or commit it.
AGORA_APP_CERTIFICATE=

# Optional: enables the selectable calm male Hindi Azure voices.
# Without these values, EasyEV uses the Agora-managed OpenAI onyx fallback.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Public HTTPS origin of the deployed Render web service.
# Example: https://easyev.onrender.com
PUBLIC_BASE_URL=

# Strong random server-only value used for short-lived MCP session URLs.
MCP_SIGNING_SECRET=

# Optional but required for the one-time readiness snapshot tool.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional. Open Charge Map can be queried without a key, but a key improves reliability.
OPENCHARGEMAP_API_KEY=

# Render Postgres connection string. Omit locally to use the labelled ephemeral fallback.
DATABASE_URL=

# Optional local server port. Defaults to 4173.
# Optional Slack incoming webhook. When set, an escalation pages the channel with
# the reason, buyer context and a one-click link into the call.
SLACK_WEBHOOK_URL=

# HubSpot private app token. Without it, leads are held in the session only.
# Create at: Settings > Integrations > Private Apps. Scopes needed:
#   crm.objects.contacts.read, crm.objects.contacts.write,
#   crm.objects.deals.read, crm.objects.deals.write
HUBSPOT_TOKEN=

# Cal.com API key and the numeric event type to book against.
# Without both, the agent offers indicative times and emails no confirmation.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# Timezone used for offering and booking slots.
BOOKING_TIMEZONE=Asia/Kolkata

# Gmail used to send the buyer's booking confirmation and decision report.
# GMAIL_APP_PASSWORD is a 16-character app password, not the account password:
# enable 2-Step Verification, then create one at myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=EasyEV
PORT=4173

# 1. Agora Realtime AI WebRTC Voice Engine
# Get credentials from: https://console.agora.io
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# --- Dealer portal and transactional mail (from the dealer/test-drive work) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM=EasyEV Test Drive <noreply@easyev.in>
