# -----------------------------------------------------------------------------
# EasyEV Environment Configuration Template
# -----------------------------------------------------------------------------
PORT=4173

# 1. Agora Realtime AI WebRTC Voice Engine
# Get credentials from: https://console.agora.io
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# 2. Email Delivery (Gmail SMTP or Resend)
# Gmail App Password can be generated at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM=EasyEV Test Drive <noreply@easyev.in>

# 3. Public Base URL
PUBLIC_BASE_URL=https://easyev.onrender.com
