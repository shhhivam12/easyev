# Public project identifier used by the browser after the server returns it.
AGORA_APP_ID=

# Server-only secret. Never place this value in index.html or commit it.
AGORA_APP_CERTIFICATE=

# Optional: enables the selectable calm male Hindi Azure voices.
# Without these values, EasyEV uses the Agora-managed OpenAI onyx fallback.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Public HTTPS origin of the deployed Render web service.
# Example: https://easyev.onrender.com
PUBLIC_BASE_URL=

# Strong random server-only value used for short-lived MCP session URLs.
MCP_SIGNING_SECRET=

# Optional but required for the one-time readiness snapshot tool.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional. Open Charge Map can be queried without a key, but a key improves reliability.
OPENCHARGEMAP_API_KEY=

# Render Postgres connection string. Omit locally to use the labelled ephemeral fallback.
DATABASE_URL=

# Optional local server port. Defaults to 4173.
PORT=4173

# Optional shared key for the specialist desk at /rep. When set, the waiting-call
# queue requires it (an individual call is still reachable with its handover code).
# Leave empty only for local demos.
REP_DESK_KEY=

# Optional Slack incoming webhook. When set, an escalation pages the channel with
# the reason, buyer context and a one-click link into the call.
SLACK_WEBHOOK_URL=
